{
  "name": "hydro-look",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open pipeline for Ecuador's hydro fleet: reservoirs, national balance and forecasts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run export:bulk",
    "build": "next build",
    "ingest": "tsx scripts/ingest.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "crosscheck": "tsx scripts/crosscheck.ts",
    "crosscheck:caudal": "tsx scripts/caudal-semantics.ts",
    "probe:ords": "tsx scripts/probe-ords.ts",
    "probe:basins": "tsx scripts/probe-basins.ts",
    "catchments": "tsx scripts/catchments.ts",
    "check": "tsx scripts/check.ts",
    "publish:api": "tsx scripts/publish.ts",
    "export:bulk": "tsx scripts/export-bulk.ts",
    "forecast": "tsx scripts/forecast.ts",
    "adequacy": "tsx scripts/adequacy.ts",
    "narrative": "tsx scripts/narrative.ts",
    "backtest:m4": "tsx scripts/backtest-m4.ts",
    "score": "tsx scripts/score.ts",
    "narrative:eval": "tsx scripts/narrative-eval.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.111",
    "cheerio": "^1.0.0",
    "geotiff": "^3.0.5",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^5.0.1"
  }
}
